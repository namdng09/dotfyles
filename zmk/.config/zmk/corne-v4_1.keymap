#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
};

/ {
    macros {
        pretmux: ctrlAP {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(A) &kp P>;
            label = "CTRLAP";
        };

        nexttmux: ctrlAN {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(A) &kp N>;
            label = "CTRLAN";
        };
    };

    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "Home Row Mod Left";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "Home Row Mod Right";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB           &lt 7 Q       &lt 4 W            &lt 6 E   &kp R      &kp T    &kp Y          &kp U      &kp I          &kp O               &kp P                 &mt LEFT_ALT BACKSPACE
&kp ESC           &hml LCTRL A  &hml LEFT_SHIFT S  &lt 3 D   &lt 2 F    &kp G    &kp H          &kp J      &kp K          &hmr RIGHT_SHIFT L  &hmr RCTRL SEMICOLON  &kp SQT
&lt 8 LEFT_SHIFT  &kp Z         &kp X              &kp C     &lt 5 V    &kp B    &kp N          &kp M      &kp COMMA      &kp DOT             &kp FSLH              &mo 10
                                                   &kp LGUI  &kp SPACE  &mo 9    &kp RG(SPACE)  &kp SPACE  &kp RIGHT_WIN
            >;
        };

        dvorak {
            display-name = "dvorak";
            bindings = <
&kp TAB  &lt 7 SINGLE_QUOTE  &lt 4 COMMA        &lt 6 DOT  &kp P      &kp Y    &kp F          &kp G      &kp C          &kp R  &kp L  &mt LEFT_ALT SLASH
&kp ESC  &hml LCTRL A        &hml LEFT_SHIFT O  &lt 3 E    &lt 2 U    &kp I    &kp D          &kp H      &kp T          &kp N  &kp S  &kp MINUS
&mo 8    &kp SEMI            &kp Q              &kp J      &lt 5 K    &kp X    &kp B          &kp M      &kp W          &kp V  &kp Z  &mo 10
                                                &kp LGUI   &kp SPACE  &mo 9    &kp RG(SPACE)  &kp SPACE  &kp RIGHT_WIN
            >;
        };

        misc {
            bindings = <
&trans  &trans  &trans  &trans  &trans     &trans    &trans             &trans                &trans         &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans    &kp LC(BACKSPACE)  &kp BACKSPACE         &kp LS(ENTER)  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans    &kp LA(DEL)        &kp LA(SINGLE_QUOTE)  &trans         &trans  &trans  &trans
                        &trans  &kp ENTER  &trans    &trans             &kp RET               &trans
            >;
        };

        arrows {
            bindings = <
&trans  &trans  &trans  &trans  &trans     &trans    &trans    &trans           &trans       &trans     &kp K_FORWARD  &trans
&trans  &trans  &trans  &trans  &trans     &trans    &kp LEFT  &kp DOWN         &kp UP       &kp RIGHT  &kp K_BACK     &trans
&trans  &trans  &trans  &trans  &trans     &trans    &trans    &kp LC(LS(TAB))  &kp LC(TAB)  &trans     &trans         &trans
                        &trans  &kp LC(V)  &trans    &trans    &kp LC(V)        &trans
            >;
        };

        marks {
            display-name = "Raise Layer";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &trans  &trans  &trans  &trans     &trans    &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp GRAVE      &kp TILDE  &kp LBKT   &trans
&trans  &trans  &trans  &trans  &trans     &trans    &kp MINUS       &kp EQUAL        &kp UNDER      &kp PLUS   &kp COLON  &trans
&trans  &trans  &trans  &trans  &trans     &trans    &kp LPAR        &kp RPAR         &kp BACKSLASH  &kp PIPE   &kp RBKT   &trans
                        &trans  &kp LC(C)  &trans    &trans          &kp LC(C)        &trans
            >;
        };

        audios {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &kp HOME          &kt PAGE_DOWN   &kp PAGE_UP   &kt END  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp K_MUTE        &kp C_VOL_DN    &kp C_VOL_UP  &trans   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp K_PLAY_PAUSE  &kp C_PREVIOUS  &kp K_NEXT    &trans   &trans  &trans
                        &trans  &trans  &trans    &trans            &trans          &trans
            >;
        };

        number {
            bindings = <
&trans  &trans  &trans  &trans  &kp LG(V)      &trans    &trans  &kp N7     &kp N8  &kp N9  &trans  &trans
&trans  &trans  &trans  &trans  &kp LG(LS(S))  &trans    &trans  &kp N4     &kp N5  &kp N6  &kp N0  &trans
&trans  &trans  &trans  &trans  &trans         &trans    &trans  &kp N1     &kp N2  &kp N3  &trans  &trans
                        &trans  &kp LC(A)      &trans    &trans  &kp LC(A)  &trans
            >;
        };

        hypr {
            bindings = <
&trans  &trans  &trans  &trans  &trans     &trans    &kp LG(LA(PG_UP))  &kp LG(PG_UP)     &kp LG(PG_DN)    &kp LG(LA(PG_DN))  &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans    &msc MOVE_X(-10)   &msc MOVE_Y(-15)  &msc MOVE_Y(15)  &msc MOVE_Y(10)    &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans    &trans             &pretmux          &nexttmux        &trans             &trans  &trans
                        &trans  &kp LC(X)  &trans    &trans             &kp LC(X)         &trans
            >;
        };

        e {
            display-name = "Lower Layer";
            bindings = <
&kp TAB     &kp N1        &kp N2        &kp N3        &kp N4        &kp N5          &kp N6    &kp N7    &kp N8    &kp N9     &kp N0  &kp BSPC
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &trans  &kp DEL
&kp LSHFT   &trans        &trans        &trans        &trans        &trans          &trans    &trans    &trans    &trans     &trans  &trans
                                        &kp LGUI      &trans        &kp SPACE       &kp RET   &trans    &kp RALT
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans          &trans          &trans        &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans          &mkp LCLK       &mkp RCLK     &trans           &trans  &trans
                        &trans  &trans  &trans    &trans          &trans          &trans
            >;
        };

        clayer {
            bindings = <
&trans  &tog 0  &tog 1  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
