{
  "permissions": {
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr merge:*)"
    ],
    "deny": [
      "Edit(**/appsettings.Production.json)",
      "Edit(**/*.db)",
      "Edit(**/*.db-*)",
      "Edit(**/*.sqlite)",
      "Edit(//etc/claude-code/**)",
      "Bash(sqlcmd:*)",
      "Bash(bcp:*)",
      "Bash(sqlpackage:*)",
      "Bash(dotnet ef database:*)",
      "Bash(dotnet-ef database:*)",
      "Bash(~/.dotnet/tools/dotnet-ef database:*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I /etc/claude-code/hooks/guard.py"
          }
        ]
      }
    ]
  }
}
